# Copy to .env.local (git-ignored) and fill in.

# YouTube Data API v3 key, for Telugu / Indian film songs.
# Create at https://console.cloud.google.com/apis/credentials and restrict it to
# your site's URLs (HTTP referrers) and to the YouTube Data API v3.
VITE_YOUTUBE_API_KEY=

# Optional: playlist shown as "Telugu hits" (defaults to an official Aditya Music playlist).
# VITE_YOUTUBE_TELUGU_PLAYLIST=PL0ZpYcTg19EEvB0BcWgOz6X6VHfE_Kr7W

# Optional: Audius discovery node (defaults to https://api.audius.co/v1/).
# VITE_API_HOST=
